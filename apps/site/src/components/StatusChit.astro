---
import { statusLabel, type Status } from '../data/features';

interface Props {
  status: Status;
}

const { status } = Astro.props;
---

<span class:list={['status', status]}>{statusLabel[status]}</span>

<style>
  .status {
    display: inline-block;
    padding: 0.2rem 0.65rem 0.2rem 0.5rem;
    font-family: var(--font-family-display);
    font-weight: 700;
    font-size: 0.875rem;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--color-plate-raised);
    color: var(--color-text);
    border-left: 4px solid var(--color-rule);
    white-space: nowrap;
  }
  .live {
    background: var(--color-signal);
    color: var(--color-signal-ink);
    border-left-color: var(--color-signal-ink);
  }
  .next {
    border-left-color: var(--color-signal);
  }
</style>
