# Cloudflare static-asset headers (https://developers.cloudflare.com/workers/static-assets/headers/).

# Hashed build output never changes, so it can be cached forever. HTML keeps
# the default revalidate so a deploy is picked up on the next load.
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable
/app/v*/assets/*
  Cache-Control: public, max-age=31536000, immutable
# The face-tracking runtime and model live in a folder named for their version.
/app/mediapipe-*
  Cache-Control: public, max-age=31536000, immutable
/app/v*/mediapipe-*
  Cache-Control: public, max-age=31536000, immutable

# Downloads (the OBS script, the Stream Deck plugin): always save, never render.
/downloads/*
  Content-Disposition: attachment

# The app loads nothing from the network but itself: this policy makes the
# "nothing is uploaded" claim checkable from the response headers.
# connect-src is the line that matters: 'self', plus the Stream Deck plugin's
# socket on this machine's loopback address (127.0.0.1, never the network).
# Camera frames, characters and rolls have nowhere else to go.
/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ws://127.0.0.1:28196; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
